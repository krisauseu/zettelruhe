# =============================================================================
# Zettelruhe — Umgebungsvariablen (Kopie nach .env, Werte ersetzen)
# Nie .env committen. In Produktion KEINE change-me-Platzhalter belassen.
# Details: docs/betrieb.md
# =============================================================================

# Öffentliche App-URL (ohne trailing slash). HTTPS in Prod setzen → Secure-Cookie.
APP_URL=http://localhost

# PocketBase aus Sicht des Next-Containers (Docker-Netz)
# Lokal ohne Compose: http://127.0.0.1:8090
PB_URL=http://pocketbase:8090

# PocketBase Superuser — nur Betrieb/Schema (/_/), NICHT App-Login der Eigentümer:in
# In Produktion starke, einzigartige Werte setzen.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-superuser

# Signatur httpOnly Session-Cookie (mind. 32 Zeichen Zufall, z. B. openssl rand -base64 48)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: Caddy Host-Port
CADDY_HTTP_PORT=80

# --- SMTP (optional; Versand Angebot/Rechnung/Zahlungserinnerung) ---
# Ohne SMTP_HOST läuft die App; Versand zeigt „SMTP ist nicht konfiguriert.“
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=zettelruhe@example.com

# Optional: Job-Tick-Intervall (ms, min 60000) bzw. Jobs abschalten
# JOB_TICK_INTERVAL_MS=900000
# JOBS_DISABLED=false

# Optional: BZSt eVatR-Basis (ohne trailing slash). Default öffentlich.
# Die Instanz braucht ausgehenden HTTPS-Zugang dorthin. Kein API-Key.
# EVATR_URL=https://api.evatr.vies.bzst.de/app
